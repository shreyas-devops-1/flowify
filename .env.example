# Spotify application credentials (server-only; never use NEXT_PUBLIC_ for secrets)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Public origin without a trailing slash. Must match the Spotify dashboard redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# 32+ random characters used to encrypt session cookies, e.g. `openssl rand -base64 32`
SESSION_SECRET=replace_with_a_long_random_secret
